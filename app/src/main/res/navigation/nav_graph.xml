<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash Screen -->
<fragment
    android:id="@+id/splashFragment"
    android:name="edu.ismt.prabin.mealmate.ui.auth.SplashFragment"
    android:label="SplashFragment"
    tools:layout="@layout/fragment_splash">
    <action
        android:id="@+id/action_splash_to_landing"
        app:destination="@id/landingFragment" />
    <action
        android:id="@+id/action_splash_to_main"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/splashFragment"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_splashFragment_to_homeFragment"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/splashFragment"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_splashFragment_to_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/splashFragment"
        app:popUpToInclusive="true" />
</fragment>

<!-- Landing Screen -->
<fragment
    android:id="@+id/landingFragment"
    android:name="edu.ismt.prabin.mealmate.ui.onboarding.LandingFragment"
    android:label="LandingFragment"
    tools:layout="@layout/fragment_landing">
    <action
        android:id="@+id/action_landing_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/landingFragment"
        app:popUpToInclusive="true" />
</fragment>

<!-- Login/Register Screen -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="edu.ismt.prabin.mealmate.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment" />
    </fragment>

    <!-- Register Screen -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="edu.ismt.prabin.mealmate.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Home Dashboard -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="edu.ismt.prabin.mealmate.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_recipeDetailFragment"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <!-- Recipe Creation Screen -->
    <fragment
        android:id="@+id/createRecipeFragment"
        android:name="edu.ismt.prabin.mealmate.ui.recipe.CreateRecipeFragment"
        android:label="Create Recipe"
        tools:layout="@layout/fragment_create_recipe">
        <argument
            android:name="recipeId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Recipe Detail Screen -->
    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="edu.ismt.prabin.mealmate.ui.recipe.RecipeDetailFragment"
        android:label="Recipe Details"
        tools:layout="@layout/fragment_recipe_details">
        <argument
            android:name="recipeId"
            app:argType="string" />
        <action
            android:id="@+id/action_recipeDetailFragment_to_createRecipeFragment"
            app:destination="@id/createRecipeFragment" />
    </fragment>

    <!-- Shopping List Manager -->
    <fragment
        android:id="@+id/shoppingListFragment"
        android:name="edu.ismt.prabin.mealmate.ui.shopping.ShoppingListFragment"
        android:label="Shopping List"
        tools:layout="@layout/fragment_shopping_list" />

    <!-- User Profile -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="edu.ismt.prabin.mealmate.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Recipe List Screen -->
    <fragment
        android:id="@+id/recipeListFragment"
        android:name="edu.ismt.prabin.mealmate.ui.recipe.RecipeListFragment"
        android:label="Recipe List"
        tools:layout="@layout/fragment_recipe_list">
        <action
            android:id="@+id/action_recipeList_to_recipeDetail"
            app:destination="@id/recipeDetailFragment" />
        <action
            android:id="@+id/action_recipeListFragment_to_createRecipeFragment"
            app:destination="@id/createRecipeFragment" />
    </fragment>

    <!-- Reset Password Screen -->
    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="edu.ismt.prabin.mealmate.ui.auth.ResetPasswordFragment"
        android:label="Reset Password"
        tools:layout="@layout/fragment_reset_password">
        <action
            android:id="@+id/action_resetPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>