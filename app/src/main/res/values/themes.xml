<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.MealMate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- Tertiary brand colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        
        <!-- Surface colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOnBackground">@color/on_background</item>
        
        <!-- Other system colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        
        <!-- Material 3 Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.MealMate.Card</item>
        <item name="textInputStyle">@style/Widget.MealMate.TextInputLayout</item>
        <item name="buttonStyle">@style/Widget.MealMate.Button</item>
        <item name="toolbarStyle">@style/Widget.MealMate.Toolbar</item>
        <item name="snackbarStyle">@style/Widget.MealMate.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.MealMate.Button.TextButton.Snackbar</item>
        <item name="chipStyle">@style/Widget.MealMate.Chip</item>
        <item name="searchViewStyle">@style/Widget.MealMate.SearchView</item>
        <item name="materialButtonToggleGroupStyle">@style/Widget.Material3.MaterialButtonToggleGroup</item>
        <item name="bottomNavigationStyle">@style/Widget.MealMate.BottomNavigation</item>
        
        <!-- System UI -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.MealMate.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mealmate</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.MealMate</item>
        
        <!-- Hide system bars -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MealMate" parent="Base.Theme.MealMate" />

    <!-- Custom styles -->
    <style name="Widget.MealMate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="rippleColor">@color/state_layer_pressed</item>
    </style>

    <style name="Widget.MealMate.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <style name="Widget.MealMate.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">@color/state_layer_pressed</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="Widget.MealMate.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/secondary</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">@color/state_layer_pressed</item>
    </style>

    <style name="Widget.MealMate.Button.TextButton.Snackbar" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/state_layer_pressed</item>
    </style>

    <style name="Widget.MealMate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MealMate.Toolbar</item>
        <item name="titleTextAppearance">@style/TextAppearance.MealMate.Toolbar</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.MealMate.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.MealMate.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/state_layer_pressed</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="Widget.MealMate.SearchView" parent="Widget.Material3.SearchView">
        <item name="queryBackground">@color/surface_container</item>
        <item name="submitBackground">@color/surface_container</item>
    </style>

    <style name="Widget.MealMate.RangeSlider" parent="Widget.Material3.Slider">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MealMate.RangeSlider</item>
        <item name="labelStyle">@style/Widget.MealMate.Tooltip</item>
    </style>

    <style name="ThemeOverlay.MealMate.RangeSlider" parent="">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
    </style>

    <style name="Widget.MealMate.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
    </style>
    
    <style name="Widget.MealMate.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.MealMate.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MealMate.BottomNavigation</item>
    </style>

    <style name="ThemeOverlay.MealMate.BottomNavigation" parent="">
        <item name="colorSurface">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
    </style>

    <style name="ThemeOverlay.MealMate.Toolbar" parent="">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="colorOnPrimary">?attr/colorSurface</item>
    </style>

    <style name="TextAppearance.MealMate.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.MealMate.ProgressOverlay" parent="android:Widget">
        <item name="android:background">@color/scrim</item>
        <item name="android:alpha">0.5</item>
    </style>

    <!-- Core Splash Screen theme -->
    <style name="Theme.MealMate.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">@color/background</item>
        
        <!-- Animated splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/mealmate</item>
        <item name="windowSplashScreenAnimationDuration">100</item>
        
        <!-- Theme to use after splash screen is gone -->
        <item name="postSplashScreenTheme">@style/Theme.MealMate</item>
        
        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- Status bar and navigation bar styling -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>